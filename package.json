{
  "name": "github-webhook-types",
  "version": "0.0.0",
  "deprecated": "This package is deprecated. Use @octokit/webhooks-types instead.",
  "homepage": "https://github.com/snomiao/github-webhook-types#readme",
  "license": "MIT",
  "author": "snomiao <snomiao@gmail.com>",
  "files": [
    "*.ts",
    "dist"
  ],
  "repository": "https://github.com/snomiao/github-webhook-types",
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist",
    "prerelease": "bun run build && bun run test",
    "release": "bunx standard-version && git push --follow-tags && npm publish",
    "test": "bun test",
    "prepare": "husky",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsrs --noEmit"
  },
  "type": "module",
  "exports": {
    "import": "./dist/index.js",
    "types": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "dependencies": {
    "@octokit/openapi-types": "^25.1.0",
    "@octokit/webhooks": "^14.1.3",
    "lint-staged": "^16.1.5",
    "octokit": "^5.0.3"
  },
  "devDependencies": {
    "@types/bun": "^1.2.20",
    "@types/jest": "^30.0.0",
    "expect-type": "^1.2.2",
    "husky": "^9.1.7",
    "oxfmt": "0.79.0",
    "semantic-release": "^24.2.7",
    "tsrs": "0.25.0-ts7.1.0-beta"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "bun test",
      "tsrs --noEmit"
    ]
  }
}
